<div id="itemModal" class="item-modal" role="dialog" aria-labelledby="itemModalName" aria-hidden="true">
  <div class="item-modal-overlay" id="itemModalOverlay"></div>
  <div class="item-modal-sheet">
    <div class="item-modal-drag" aria-hidden="true"></div>
    <button type="button" class="item-modal-close" id="itemModalClose" aria-label="<%= mt('menu.close') %>">
      <svg class="icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#close"></use></svg>
    </button>
    <img id="itemModalImage" class="item-modal-image" src="" alt="" style="display:none;">
    <div class="item-modal-body">
      <h3 id="itemModalName" class="item-modal-name"></h3>
      <p id="itemModalDescription" class="item-modal-description" style="display:none;"></p>
      <div id="itemModalDietarySection" class="item-modal-section" style="display:none;">
        <h4 class="item-modal-section-title"><%= mt('info.dietary_title') %></h4>
        <div id="itemModalDietaryTags" class="item-modal-tags"></div>
      </div>
      <div id="itemModalAllergenSection" class="item-modal-section" style="display:none;">
        <h4 class="item-modal-section-title"><%= mt('info.allergens_title') %></h4>
        <div id="itemModalAllergenTags" class="item-modal-tags"></div>
      </div>
      <p id="itemModalNoInfo" class="item-modal-no-info" style="display:none;"><%= mt('info.no_info') %></p>
    </div>
  </div>
</div>
