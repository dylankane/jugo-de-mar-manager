<%
  const itemTrans      = pickT(item.translations);
  const itemName       = itemTrans.name         || 'Menu Item';
  const itemDesc       = itemTrans.description  || '';
  const itemNotes      = itemTrans.public_notes  || '';

  const finalPrice = item.has_discount
    ? (item.discount_type === 'percent'
        ? parseFloat(item.price) * (1 - parseFloat(item.discount_value) / 100)
        : parseFloat(item.price) - parseFloat(item.discount_value))
    : parseFloat(item.price);

  const dietaryList  = (item.dietary  || []).map(d => pickT(d.dietary_tag.translations).name).filter(Boolean);
  const allergenList = (item.allergens || []).map(a => pickT(a.allergen.translations).name).filter(Boolean);
  const hasModal     = item.image_url || dietaryList.length > 0 || allergenList.length > 0;
%>
<article class="menu-item" data-item-id="<%= item.id %>">
  <div class="menu-item-header">
    <div class="menu-item-name-wrap">
      <h4 class="menu-item-name"><%= itemName %></h4>
      <% if (item.is_special) { %>
        <span class="special-badge badge" aria-label="<%= mt('menu.special') %>"><%= mt('menu.special') %></span>
      <% } %>
    </div>
    <span class="menu-item-price">€<%= finalPrice.toFixed(2) %></span>
  </div>

  <% if (itemDesc) { %>
    <p class="menu-item-description"><%= itemDesc %></p>
  <% } %>

  <% if (itemNotes) { %>
    <p class="menu-item-notes"><%= itemNotes %></p>
  <% } %>

  <% if (hasModal) { %>
    <div class="menu-item-actions">
      <button
        type="button"
        class="item-detail-trigger"
        data-item-name="<%= itemName %>"
        data-item-description="<%= itemDesc %>"
        data-item-image="<%= item.image_url || '' %>"
        data-dietary="<%= JSON.stringify(dietaryList) %>"
        data-allergens="<%= JSON.stringify(allergenList) %>"
        aria-label="<%= mt('menu.view_details') %>"
      >
        <svg class="icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#info-circle"></use></svg>
        <%= mt('menu.view_details') %>
      </button>
    </div>
  <% } %>
</article>
