<%
  const setMenuTrans     = pickT(setMenu.translations);
  const setMenuName      = setMenuTrans.name || 'Set Menu';
  const setMenuDesc      = setMenuTrans.description || '';
  const setMenuNotes     = setMenuTrans.public_notes || '';
  const setMenuPriceNote = setMenuTrans.price_note || '';
  const courseCount      = (setMenu.courses || []).length;

  const hasPrice   = setMenu.price != null;
  const finalPrice = hasPrice
    ? (setMenu.has_discount
        ? (setMenu.discount_type === 'percent'
            ? Number(setMenu.price) * (1 - Number(setMenu.discount_value) / 100)
            : Number(setMenu.price) - Number(setMenu.discount_value))
        : Number(setMenu.price))
    : null;
%>
<article class="set-menu-item set-menu-item--compact" data-set-menu-id="<%= setMenu.id %>">
  <div class="set-menu-header">
    <div class="set-menu-name-wrap">
      <h4 class="set-menu-name"><%= setMenuName %></h4>
      <span class="set-menu-badge badge"><%= mt('menu.set_menu_label') %></span>
    </div>
    <% if (hasPrice || setMenuPriceNote) { %>
      <div class="item-pricing">
        <% if (hasPrice) { %>
          <span class="set-menu-price">€<%= finalPrice.toFixed(2) %></span>
        <% } %>
        <% if (setMenuPriceNote) { %>
          <span class="item-price-note"><%= setMenuPriceNote %></span>
        <% } %>
      </div>
    <% } %>
  </div>

  <% if (setMenuDesc) { %>
    <p class="set-menu-description"><%= setMenuDesc %></p>
  <% } %>

  <% if (setMenuNotes) { %>
    <p class="set-menu-notes">- <%= setMenuNotes %></p>
  <% } %>

  <div class="set-menu-actions">
    <% if (courseCount > 0) { %>
      <span class="set-menu-course-count">&#9679; <%= courseCount %> <%= mt('menu.courses_count') %></span>
    <% } %>
    <button
      type="button"
      class="set-menu-expand-trigger"
      aria-expanded="false"
      aria-controls="sm-detail-<%= setMenu.id %>"
      aria-label="<%= mt('menu.view_details') %>"
    >
      <svg class="icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#chevron-down"></use></svg>
    </button>
  </div>

  <div class="set-menu-details set-menu-details--collapsible"
       id="sm-detail-<%= setMenu.id %>"
       aria-hidden="true">

    <% if (setMenu.courses && setMenu.courses.length > 0) { %>
      <div class="set-menu-courses">
        <% setMenu.courses.forEach(courseSection => { %>
          <% const courseTrans     = pickT(courseSection.course.translations); %>
          <% const courseNoteTrans = pickT(courseSection.translations); %>
          <div class="set-menu-course">
            <div class="set-menu-course-title"><%= courseTrans.name || 'Course' %></div>
            <% if (courseNoteTrans.notes) { %>
              <div class="set-menu-course-note"><%= courseNoteTrans.notes %></div>
            <% } %>
            <% if (courseSection.dishes && courseSection.dishes.length > 0) { %>
              <div class="set-menu-dishes">
                <% courseSection.dishes.forEach(dishItem => { %>
                  <% if (dishItem.dish) { %>
                    <% const dishTrans     = pickT(dishItem.dish.translations); %>
                    <% const dishNoteTrans = pickT(dishItem.translations); %>
                    <%
                      const dishDietaryList  = (dishItem.dish.dietary  || []).map(d => pickT(d.dietary_tag.translations).name).filter(Boolean);
                      const dishAllergenList = (dishItem.dish.allergens || []).map(a => pickT(a.allergen.translations).name).filter(Boolean);
                      const dishHasModal     = dishDietaryList.length > 0 || dishAllergenList.length > 0;
                    %>
                    <div class="set-menu-dish">
                      <div class="set-menu-dish-inner">
                        <span class="set-menu-dish-name">
                          <%= dishTrans.name || 'Dish' %>
                          <% if (dishHasModal) { %>
                            <button
                              type="button"
                              class="item-detail-trigger"
                              data-item-name="<%= dishTrans.name || 'Dish' %>"
                              data-item-description=""
                              data-item-image=""
                              data-dietary="<%= JSON.stringify(dishDietaryList) %>"
                              data-allergens="<%= JSON.stringify(dishAllergenList) %>"
                              aria-label="<%= mt('menu.view_details') %>"
                            >
                              <svg class="icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#info-circle"></use></svg>
                            </button>
                          <% } %>
                        </span>
                        <% if (dishTrans.description) { %>
                          <div class="set-menu-dish-description"><%= dishTrans.description %></div>
                        <% } %>
                        <% if (dishNoteTrans.notes) { %>
                          <div class="set-menu-dish-description">- <%= dishNoteTrans.notes %></div>
                        <% } %>
                      </div>
                    </div>
                  <% } %>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>


    <button
      type="button"
      class="set-menu-collapse-trigger"
      aria-label="Collapse"
      data-sm-controls="sm-detail-<%= setMenu.id %>"
    >
      <svg class="icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#chevron-down"></use></svg>
    </button>

  </div>
</article>
