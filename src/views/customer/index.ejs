<!DOCTYPE html>
<html lang="<%= lang %>">
<%- include('../partials/customer_head', { title: mt('menu.page_title'), restaurantName }) %>
<body>

  <%- include('./partials/topbar', { lang, enabledLangs }) %>

  <div class="menu-page">

    <header class="menu-page-header menu-page-header--has-image" style="background-image:url('/customer/media/home-hero-1-big.webp')">
      <h1 class="restaurant-name">
        <% restaurantName.split(' ').forEach(function(word) { %><span class="restaurant-name__word"><%= word %></span>
        <% }); %>
      </h1>
      <% const subtitleText = mt('menu.subtitle'); %>
      <% if (subtitleText && subtitleText !== 'menu.subtitle') { %>
        <p class="menu-subtitle"><%= subtitleText %></p>
      <% } %>
    </header>

    <% if (categories && categories.length > 0) { %>
    <nav id="categoryNav" class="category-nav">
      <div class="category-nav-wrap">
        <div class="category-nav-inner" id="categoryNavInner">
          <% categories.forEach((category, index) => { %>
            <% const categoryNavTrans = pickT(category.translations); %>
            <a
              href="#category-<%= category.id %>"
              class="category-nav-link<%= index === 0 ? ' active' : '' %>"
              data-category="<%= category.id %>"
            ><%= categoryNavTrans.name || 'Category' %></a>
          <% }); %>
        </div>
        <div class="category-nav-chevron" id="categoryNavChevron" aria-hidden="true">
          <svg class="icon"><use href="/customer/icons/sprite.svg#chevron-right"></use></svg>
        </div>
      </div>
    </nav>
    <% } %>

    <main class="menu-content">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(category => { %>
          <% const categoryTrans = pickT(category.translations); %>
          <section class="category-section" id="category-<%= category.id %>">

            <%# IMAGE HEADER — disabled pending client decision on per-category images %>
            <%# To re-enable: delete the plain header block below and change `if (false)` to `if (true)` %>
            <% if (false) { %>
              <div class="category-header<%= category.image_url ? ' category-header--has-image' : '' %>"<%= category.image_url ? ' style="background-image:url(\'' + category.image_url + '\')"' : '' %>>
                <h2 class="category-title"><%= categoryTrans.name || 'Category' %></h2>
              </div>
              <% if (!category.image_url && categoryTrans.description) { %>
                <p class="category-description"><%= categoryTrans.description %></p>
              <% } %>
            <% } %>
            <div class="category-header">
              <h2 class="category-title"><%= categoryTrans.name || 'Category' %></h2>
            </div>
            <% if (categoryTrans.description) { %>
              <p class="category-description"><%= categoryTrans.description %></p>
            <% } %>

            <%
              const items = (category.menu_item_categories || [])
                .filter(mic => mic.menu_item && mic.menu_item.is_available)
                .map(mic => ({ type: 'item', data: mic.menu_item, order: mic.display_order }));
              const setMenus = (category.set_menu_categories || [])
                .filter(smc => smc.set_menu && smc.set_menu.is_available)
                .map(smc => ({ type: 'set_menu', data: smc.set_menu, order: smc.display_order }));
              const allContent = [...items, ...setMenus].sort((a, b) => a.order - b.order);
            %>

            <% if (allContent.length > 0) { %>
              <div class="menu-items-grid">
                <% allContent.forEach(content => { %>
                  <% if (content.type === 'item') { %>
                    <%- include('./partials/menu-item', { item: content.data, pickT, lang, mt }) %>
                  <% } else if (content.type === 'set_menu') { %>
                    <%- include('./partials/set-menu', { setMenu: content.data, pickT, lang, mt }) %>
                  <% } %>
                <% }); %>
              </div>
            <% } %>

            <% if (category.children && category.children.length > 0) { %>
              <% category.children.forEach(subcategory => { %>
                <% const subTrans = pickT(subcategory.translations); %>
                <%
                  const subItems = (subcategory.menu_item_categories || [])
                    .filter(mic => mic.menu_item && mic.menu_item.is_available)
                    .map(mic => ({ type: 'item', data: mic.menu_item, order: mic.display_order }));
                  const subSetMenus = (subcategory.set_menu_categories || [])
                    .filter(smc => smc.set_menu && smc.set_menu.is_available)
                    .map(smc => ({ type: 'set_menu', data: smc.set_menu, order: smc.display_order }));
                  const subAllContent = [...subItems, ...subSetMenus].sort((a, b) => a.order - b.order);
                %>
                <% if (subAllContent.length > 0) { %>
                  <div class="subcategory-section">
                    <div class="subcategory-header">
                      <h3 class="subcategory-title"><%= subTrans.name || 'Subcategory' %></h3>
                      <% if (subTrans.description) { %>
                        <p class="subcategory-description"><%= subTrans.description %></p>
                      <% } %>
                    </div>
                    <div class="menu-items-grid">
                      <% subAllContent.forEach(content => { %>
                        <% if (content.type === 'item') { %>
                          <%- include('./partials/menu-item', { item: content.data, pickT, lang, mt }) %>
                        <% } else if (content.type === 'set_menu') { %>
                          <%- include('./partials/set-menu', { setMenu: content.data, pickT, lang, mt }) %>
                        <% } %>
                      <% }); %>
                    </div>
                    <% if (subTrans.public_notes) { %>
                      <p class="category-notes"><%= subTrans.public_notes %></p>
                    <% } %>
                  </div>
                <% } %>
              <% }); %>
            <% } %>

            <% if (categoryTrans.public_notes) { %>
              <p class="category-notes"><%= categoryTrans.public_notes %></p>
            <% } %>

          </section>
        <% }); %>
      <% } else { %>
        <div class="menu-empty">
          <p class="menu-empty-text"><%= mt('menu.empty') %></p>
        </div>
      <% } %>
    </main>

    <section class="club-banner">
      <div class="club-banner-content">
        <svg class="club-banner-icon icon" aria-hidden="true"><use href="/customer/icons/sprite.svg#star-outline"></use></svg>
        <div class="club-banner-text">
          <h3 class="club-banner-title"><%= mt('club.banner.title') %></h3>
          <p class="club-banner-description"><%= mt('club.banner.desc') %></p>
        </div>
        <a href="/menu/club-join?lang=<%= lang %>" class="club-banner-btn btn"><%= mt('club.banner.btn') %></a>
      </div>
    </section>

    <footer class="menu-footer">
      <p class="menu-footer-text"><%= mt('footer.tagline') %></p>
      <div class="menu-footer-links">
        <a href="/menu/legal?lang=<%= lang %>" class="menu-footer-link"><%= mt('footer.legal') %></a>
      </div>
    </footer>

  </div>

  <%- include('./partials/boceto-footer') %>

  <%- include('./partials/item-modal', { mt }) %>

  <script src="/customer/js/menu.js"></script>
  <%- include('./partials/cookie-banner', { mt }) %>
</body>
</html>
